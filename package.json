{
  "name": "zentra-finance",
  "version": "0.1.0",
  "description": "Zentra Finance - Banking & Financial Management for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite --config vite.config.mjs\" \"wait-on http://localhost:5173 && cross-env ELECTRON_IS_DEV=1 electron .\"",
    "build:renderer": "vite build --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs && electron-builder",
    "build:legacy": "electron-packager . ZentraFinance --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=dist --ignore=.git",
    "lint": "eslint main.js src/preload.js src/index.html"
  },
  "build": {
    "appId": "com.zentra.finance",
    "productName": "Zentra Finance",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "src-svelte/**/*",
      "dist-renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "electron": "^28.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "eslint": "^10.1.0",
    "eslint-plugin-html": "^8.1.4",
    "svelte": "^4.2.19",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
