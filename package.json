{
  "name": "zentra-finance",
  "version": "1.0.3",
  "description": "Zentra Finance - Banking & Financial Management for Windows",
  "main": "main.js",
  "author": {
    "name": "Javad Qasemi",
    "email": "codenavisan@gmail.com"
  },
  "homepage": "https://github.com/javadqasemi/Zentra-Finance",
  "repository": {
    "type": "git",
    "url": "https://github.com/javadqasemi/Zentra-Finance.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite --config vite.config.mjs\" \"wait-on http://localhost:5173 && cross-env ELECTRON_IS_DEV=1 electron .\"",
    "build:renderer": "vite build --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs && electron-builder --win --x64",
    "release": "vite build --config vite.config.mjs && electron-builder --win --x64 --publish always",
    "release:draft": "vite build --config vite.config.mjs && electron-builder --win --x64 --publish onTagOrDraft",
    "pack": "vite build --config vite.config.mjs && electron-builder --dir",
    "lint": "eslint main.js src/preload.js src/index.html",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.zentra.finance",
    "productName": "Zentra Finance",
    "copyright": "Copyright © 2026 Javad Qasemi",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "src/**/*",
      "db/**/*",
      "dist-renderer/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/.DS_Store",
      "!**/Thumbs.db",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "src/logo.png",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "publisherName": "Javad Qasemi",
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zentra Finance",
      "uninstallDisplayName": "Zentra Finance ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "Zentra Finance",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "javadqasemi",
        "repo": "Zentra-Finance",
        "releaseType": "release",
        "vPrefixedTagName": true
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "better-sqlite3": "^12.9.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^10.1.0",
    "eslint-plugin-html": "^8.1.4",
    "svelte": "^4.2.19",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
